# ==============================================================================
# Mneme Environment Configuration
# Copy this file to .env and adjust variables as required for your environment:
#   cp .env.example .env
# ==============================================================================

# --- Flask Server Settings ---
FLASK_ENV=development
FLASK_DEBUG=false
SECRET_KEY=change-this-to-a-secure-random-secret-in-production
HOST=0.0.0.0
PORT=5000

# --- Upload Constraints ---
# Maximum file upload size in bytes (50 MB default)
MAX_CONTENT_LENGTH=52428800

# --- MongoDB Database Settings ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=mneme

# --- Qdrant Vector Database Settings ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
# Optional: Set QDRANT_URL and QDRANT_API_KEY if using Qdrant Cloud or remote cluster
# QDRANT_URL=https://your-cluster.qdrant.io:6333
# QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION=mneme_documents
VECTOR_DIMENSION=384

# --- Celery & Redis Task Queue Settings ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --- Local AI & LLM Settings ---
# Hugging Face model repository or local path for Gemma 2B Instruct
MODEL_NAME=google/gemma-2b-it
USE_4BIT_QUANT=true
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
LLM_TEMPERATURE=0.2
LLM_MAX_NEW_TOKENS=1024

# Default Tenant ID (used when X-User-Id header is not supplied)
DEFAULT_USER_ID=user_default

